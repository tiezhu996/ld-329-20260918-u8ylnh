# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=cyskillswap

# 数据库连接信息
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# 后端 JWT 签名密钥（演示用，生产请替换为随机长字符串）
JWT_SECRET=change_me_to_a_long_random_string

# 端口映射（本机冲突时修改后重新 docker compose up -d）
FRONTEND_PORT=18629
BACKEND_PORT=19629
DB_PORT=17629
